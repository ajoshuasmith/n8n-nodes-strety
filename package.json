{
	"name": "@joshuanode/n8n-nodes-strety",
	"version": "0.2.0",
	"description": "n8n community node for the Strety strategic planning platform",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"strety",
		"strategic-planning",
		"eos"
	],
	"license": "MIT",
	"homepage": "https://github.com/ajoshuasmith/n8n-nodes-strety",
	"author": {
		"name": "Joshua Smith"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ajoshuasmith/n8n-nodes-strety.git"
	},
	"bugs": {
		"url": "https://github.com/ajoshuasmith/n8n-nodes-strety/issues"
	},
	"engines": {
		"node": ">=18.17.0"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes/**/*.ts credentials/**/*.ts",
		"lintfix": "eslint nodes/**/*.ts credentials/**/*.ts --fix",
		"prepublishOnly": "npm run build",
		"test": "npm run build && node --test tests/*.test.cjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/StretyOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Strety/Strety.node.js"
		]
	},
	"devDependencies": {
		"@typescript-eslint/parser": "~7.18.0",
		"eslint": "~8.56.0",
		"eslint-plugin-n8n-nodes-base": "~1.16.2",
		"gulp": "~4.0.2",
		"n8n-workflow": "*",
		"prettier": "~3.3.2",
		"typescript": "~5.5.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
